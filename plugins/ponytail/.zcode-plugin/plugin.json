{
  "name": "ponytail",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/zcode-ponytail.cjs",
              "SessionStart"
            ],
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/zcode-ponytail.cjs",
              "UserPromptSubmit"
            ],
            "timeoutMs": 15000
          }
        ]
      }
    ]
  },
  "version": "5.3.3"
}
