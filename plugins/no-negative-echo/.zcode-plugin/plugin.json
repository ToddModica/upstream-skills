{
  "name": "no-negative-echo",
  "version": "0.1.3",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/no-negative-echo.js",
